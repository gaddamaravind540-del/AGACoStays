AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres

JWT_SECRET=replace-with-a-strong-base64-secret
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=7

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

USER_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8090

PASSWORD_RESET_EXPIRATION_MINUTES=15
OTP_EXPIRATION_MINUTES=5
OTP_EXPOSE_IN_DEVELOPMENT=true
AUTH_TOKEN_CLEANUP_CRON=0 0/30 * * * *
